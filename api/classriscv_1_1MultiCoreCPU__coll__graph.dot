digraph "riscv::MultiCoreCPU"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="riscv::MultiCoreCPU",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Multi-core SoC simulation container."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" config_",fontcolor="grey" ];
  Node2 [id="Node000002",label="riscv::MultiCoreConfig",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1MultiCoreConfig.html",tooltip="System-level configuration for the multi-core SoC."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" pipeline",fontcolor="grey" ];
  Node3 [id="Node000003",label="riscv::PipelineConfig",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1PipelineConfig.html",tooltip="Pipeline configuration knobs."];
  Node4 -> Node2 [id="edge3_Node000002_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" l1d\nl2\nl3",fontcolor="grey" ];
  Node4 [id="Node000004",label="riscv::CacheConfig",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structriscv_1_1CacheConfig.html",tooltip="Configuration for a single cache level."];
}
